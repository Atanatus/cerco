{
  "name": "cerco-api",
  "main": "index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "vars": { "CHAT_ENABLED": "true", "GUEST_IDENTITY_REQUIRED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "PublicChat" }]
  },
  "migrations": [{ "tag": "chat-v1", "new_sqlite_classes": ["PublicChat"] }],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cerco-production",
      "database_id": "4e85d0b5-f4dc-4c89-980a-b388dd1b98bb",
      "migrations_dir": "../d1/migrations"
    }
  ]
}
